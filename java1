import java.util.Scanner; // Imports the Scanner class for user input

public class AddTwoNumbers {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in); // Creates a Scanner object for input

        System.out.println("Enter the first number:");
        int num1 = scanner.nextInt(); // Reads the first integer from the user

        System.out.println("Enter the second number:");
        int num2 = scanner.nextInt(); // Reads the second integer from the user

        int sum = num1 + num2; // Calculates the sum

        System.out.println("The sum of " + num1 + " and " + num2 + " is: " + sum); // Prints the result

        scanner.close(); // Closes the scanner
    }
}

